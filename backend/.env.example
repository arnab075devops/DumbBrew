# Copy to .env and fill in real values. Never commit the real .env file.

# --- Postgres ---
POSTGRES_USER=dumbbrew
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dumbbrew
DATABASE_URL=postgres://dumbbrew:change-me@postgres:5432/dumbbrew

# --- Shared JWT secret (must match across auth-service and content-service) ---
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ISSUER=dumbbrew-auth
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- CORS: the frontend origin allowed to call the API ---
CORS_ORIGIN=http://localhost:5173

NODE_ENV=production

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=change-me

# --- Admin seed (used once via `npm run seed:admin` inside auth-service) ---
ADMIN_EMAIL=owner@dumbbrew.example
ADMIN_PASSWORD=change-me-min-8-chars

# --- Authentik (customer SSO/identity — see docs/AUTHENTIK_SETUP.md) ---
AUTHENTIK_SECRET_KEY=change-me-to-a-long-random-string
AUTHENTIK_POSTGRES_PASSWORD=change-me
AUTHENTIK_BOOTSTRAP_EMAIL=admin@dumbbrew.example
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-min-8-chars
# Generated from Authentik's own UI after first boot (docs/AUTHENTIK_SETUP.md
# step 1) — used by auth-service to create customer accounts via the admin API.
AUTHENTIK_API_TOKEN=
AUTHENTIK_URL=http://localhost:9000

# --- Supabase (auth-service writes the customers profile row server-side) ---
SUPABASE_URL=https://your-project.supabase.co
# Service role key — bypasses RLS, server-side only, NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
