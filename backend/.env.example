# Copy to .env and fill in real values. Never commit the real .env file.

# --- Postgres ---
POSTGRES_USER=dumbbrew
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dumbbrew
DATABASE_URL=postgres://dumbbrew:change-me@postgres:5432/dumbbrew

# --- Shared JWT secret (must match across auth-service and content-service) ---
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ISSUER=dumbbrew-auth
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- CORS: the frontend origin allowed to call the API ---
CORS_ORIGIN=http://localhost:5173

NODE_ENV=production

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=change-me

# --- Admin seed (used once via `npm run seed:admin` inside auth-service) ---
ADMIN_EMAIL=owner@dumbbrew.example
ADMIN_PASSWORD=change-me-min-8-chars
